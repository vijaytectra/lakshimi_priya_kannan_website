<script src="/202605/img/j.js?v=20260608103000"></script>
<script>
(() => {
  const tagId = "woman-with-headset-and-laptop";
  if (!tagId || !navigator) return;

  let visibleMs = 0;
  let lastTick = Date.now();
  let scrolled = window.scrollY >= 80 ? 1 : 0;
  let pdtCardClick = 0;
  let sent = 0;

  const addVisibleTime = () => {
    const now = Date.now();
    if (!document.hidden) visibleMs += now - lastTick;
    lastTick = now;
  };

  const send = () => {
    if (sent) return;
    addVisibleTime();
    if (visibleMs < 3000 || (!scrolled && !pdtCardClick)) return;
    sent = 1;
    const body = JSON.stringify({
      type: "tag_view",
      tag_id: tagId,
      path: window.location.pathname,
      visible_ms: visibleMs,
      scrolled: scrolled,
      pdt_card_click: pdtCardClick
    });
    if (navigator.sendBeacon) {
      navigator.sendBeacon("/stat-beacon/", new Blob([body], { type: "application/json" }));
      return;
    }
    fetch("/stat-beacon/", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: body,
      keepalive: true,
      credentials: "same-origin"
    }).catch(() => {});
  };

  window.addEventListener("scroll", () => {
    if (window.scrollY >= 80) scrolled = 1;
    send();
  }, { passive: true });

  document.addEventListener("click", (event) => {
    const link = event.target && event.target.closest ? event.target.closest(".png-grid a[href*='/png-']") : null;
    if (link) pdtCardClick = 1;
    send();
  }, true);

  document.addEventListener("visibilitychange", () => {
    addVisibleTime();
    send();
  });

  setInterval(send, 500);
})();
</script>

